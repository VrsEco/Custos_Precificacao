# Copie este arquivo para .env (nunca commitar o .env real)
APP_ENV=dev

# Fase 1 (dev): sem banco compartilhado — cada dev roda seu próprio Postgres local.
# Crie uma role/banco dedicados (não use o superusuário postgres):
#   CREATE ROLE custos_precificacao WITH LOGIN PASSWORD 'escolha_uma_senha';
#   CREATE DATABASE custos_precificacao_dev OWNER custos_precificacao;
DATABASE_URL=postgresql+psycopg2://custos_precificacao:escolha_uma_senha@localhost:5432/custos_precificacao_dev
