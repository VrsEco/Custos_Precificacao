# Copie este arquivo para .env (nunca commitar o .env real)
APP_ENV=dev

# Fase 1 (dev): sem banco compartilhado — cada dev usa Postgres local ou SQLite, se precisar.
# Fase 2 (test) e Fase 3 (prod) vão preencher DATABASE_URL apontando para o Postgres de cada ambiente:
# DATABASE_URL=postgresql://usuario:senha@host:5432/nome_do_banco
DATABASE_URL=
